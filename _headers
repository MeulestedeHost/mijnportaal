# img-src heeft er sinds de FIFA Wereldreis tile.openstreetmap.org bij staan:
# de kaarttegels van Leaflet zijn gewone afbeeldingen, en zonder deze host
# blokkeert de CSP ze allemaal en blijft de kaart leeg grijs. Wissel je ooit van
# tegelaanbieder (js/wereldreis.js), zet dan hier de nieuwe host.
# Leaflet zelf komt als script van jsdelivr (al toegelaten) en zijn stylesheet
# staat lokaal in css/leaflet.css, want style-src blijft bewust op 'self'.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; connect-src 'self' https://*.supabase.co; style-src 'self'; img-src 'self' data: https://tile.openstreetmap.org; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()
